# ── LLM: OmniRoute ──────────────────────────────────
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=

# 역할별 모델 오버라이드 (선택)
OMNIROUTE_MODEL_SCOUT=
OMNIROUTE_MODEL_WRITER=
OMNIROUTE_MODEL_VERIFIER=
# Writer 최대 출력 토큰 (추론 모델은 <think>도 포함되니 넉넉하게)
OMNIROUTE_WRITER_MAX_TOKENS=6000

# ── GitHub API 한도 완화 (선택) ──
# 비로그인은 IP당 한도가 작아서, 사내망처럼 같은 IP를 여럿이 쓰면 금방 소진됩니다.
# github.com/settings/tokens 에서 권한(scope) 체크 없이 발급하면 됩니다(무료).
GITHUB_TOKEN=
# StackExchange API 한도 완화 (선택, 없어도 하루 300회 기본 제공)
STACKEXCHANGE_KEY=

# ── 한국어 블로그(티스토리/velog) 검색 (선택) ──────────
# 있으면 Tavily로 안정적으로 검색, 없으면 DuckDuckGo 스크래핑으로 폴백(덜 안정적).
# 무료 티어 있음: https://tavily.com
TAVILY_API_KEY=

# ── 포트폴리오 레포(배포 대상) ──────────────────────────
# 로컬에 git clone 해둔 nextjs-portpolio 레포의 절대 경로
# 예: PORTFOLIO_REPO_PATH=C:\Users\seungho\projects\nextjs-portpolio
#     PORTFOLIO_REPO_PATH=/Users/seungho/projects/nextjs-portpolio
PORTFOLIO_REPO_PATH=

# 레포 안에서 mdx 글이 저장되는 경로 (기본값이 현재 구조와 일치함)
POSTS_SUBDIR=src/app/[locale]/blog/posts

# true: 커밋 후 바로 push까지 해서 Vercel 자동 배포까지 이어짐
# false: 로컬 커밋까지만 하고 push는 직접 수동으로
AUTO_PUSH=true

# true: 다른 사람의 이미지/블로그 글을 참고한 노트는 자동 발행하지 않고 초안으로만 남김
# (원저작자 허가 후 engine.py --publish-draft 로 발행)
HOLD_THIRD_PARTY=true

# push할 브랜치
GIT_BRANCH=main

# ── 자동 실행(scheduler.py) 시각, 24시간제 ──────────────
SCHEDULE_TIME=09:00

# ── 출력 위치 (비워두면 pipeline/output_files/) ──────────
OUTPUT_DIR=

# ── 네트워크 (연결 문제가 있을 때만) ───────────────────
# 사내 프록시를 거쳐야 하면 지정 (requests가 자동으로 사용)
# HTTPS_PROXY=http://proxy.example.com:8080
# 회사가 HTTPS를 가로채서 SSL 오류가 나면: `uv add truststore` 후 (기본 true)
# USE_SYSTEM_CERTS=true
# 사내 루트 인증서 파일을 직접 지정하려면
# REQUESTS_CA_BUNDLE=C:\certs\corp-root.pem
