# ── LLM: OmniRoute ──────────────────────────────────
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=

# 역할별 모델 오버라이드 (선택)
OMNIROUTE_MODEL_SCOUT=
OMNIROUTE_MODEL_WRITER=
OMNIROUTE_MODEL_VERIFIER=
# Writer 최대 출력 토큰: 장문 오픈소스 글 생성 시 충분한 출력 여유 확보
OMNIROUTE_WRITER_MAX_TOKENS=10000
# Reviewer 최대 출력 토큰: 추론 토큰 때문에 JSON 판정이 잘리는 현상 방지
OMNIROUTE_VERIFIER_MAX_TOKENS=6144
# 기본 주제는 이 값에 따르며, 장문 오픈소스는 최대 2회 시도 × 최대 3라운드로 제한
QUALITY_ATTEMPTS=3

# 오픈소스 글 작성자에게 전달할 공식 원문 최대 문자 수 (길게 잡을수록 컨텍스트 소비 증가)
OPEN_SOURCE_WRITER_CONTEXT_CHARS=30000
# 오픈소스 검수에 전달할 공식 원문 발췌 최대 문자 수
OPEN_SOURCE_REVIEW_CONTEXT_CHARS=22000
# 기본 false: 후보 스냅샷은 저장하지 않고, 과거 output_files의 동일 파일은 logs/github_candidates로 이동
GITHUB_SAVE_CANDIDATE_SNAPSHOTS=false
# 스냅샷 저장을 켜는 경우 logs/github_candidates에 최근 N개만 유지
GITHUB_CANDIDATE_SNAPSHOT_KEEP=5

# ── GitHub API 한도 완화 (선택) ──
# 비로그인은 IP당 한도가 작아서, 사내망처럼 같은 IP를 여럿이 쓰면 금방 소진됩니다.
# github.com/settings/tokens 에서 권한(scope) 체크 없이 발급하면 됩니다(무료).
GITHUB_TOKEN=
# StackExchange API 한도 완화 (선택, 없어도 하루 300회 기본 제공)
STACKEXCHANGE_KEY=

# ── 한국어 블로그(티스토리/velog) 검색 (선택) ──────────
# 있으면 Tavily로 안정적으로 검색, 없으면 DuckDuckGo 스크래핑으로 폴백(덜 안정적).
# 무료 티어 있음: https://tavily.com
TAVILY_API_KEY=

# ── 발행 대상 저장소 (JSON 배열, 여러 저장소 지원) ────────────────
# PUBLISH_TARGETS 하나에 원하는 만큼의 대상을 추가할 수 있습니다.
# repo_path: 로컬 git clone 경로
# posts_dir: MDX를 저장할 저장소 내부 상대 경로
# category_subdirs: true면 posts_dir 아래에 algorithm/troubleshooting 폴더를 추가
# images_dir: 이미지 파일을 저장할 저장소 내부 상대 경로
# image_url_prefix: 웹페이지에서 이미지를 불러올 URL prefix
# en_posts_dir: 선택 사항. 영문 MDX를 저장할 상대 경로; 비우면 영어 번역/발행을 하지 않음
# branch: 푸시할 브랜치
#
# 아래는 일반적인 예시입니다. 실제 clone 경로와 프로젝트 구조에 맞게 수정하세요.
# Windows에서도 경로 구분자는 / 사용을 권장합니다.
PUBLISH_TARGETS='[
  {
    "name": "target-one",
    "repo_path": "C:/path/to/repository-one",
    "posts_dir": "content",
    "en_posts_dir": "",
    "category_subdirs": true,
    "images_dir": "public/blogs",
    "image_url_prefix": "/blogs",
    "branch": "main"
  },
  {
    "name": "target-two",
    "repo_path": "C:/path/to/repository-two",
    "posts_dir": "src/app/blog/posts",
    "en_posts_dir": "src/app/blog/posts/en",
    "category_subdirs": false,
    "images_dir": "public/blogs",
    "image_url_prefix": "/blogs",
    "branch": "main"
  }
]'

# true: 각 저장소에 별도로 commit + push하여 연결된 배포 플랫폼의 자동 배포를 시작
# false: 각 저장소에 로컬 커밋만 생성
AUTO_PUSH=true

# true: 제3자 자료/이미지에 의존한 글은 허가 전 자동 발행 보류
HOLD_THIRD_PARTY=true


# GitHub 오픈소스 탐색
# 사내 TLS 인증서 체인 문제로 공개 GitHub API 검증이 실패하면 false 사용
# 주의: false이면 서버 인증서 검증이 꺼집니다. 이때 GITHUB_TOKEN은 요청에 포함하지 않습니다.
GITHUB_SSL_VERIFY=false
# 분야별 검색에서 쿼리당 가져올 저장소 수 (기본 8)
GITHUB_DISCOVERY_LIMIT=8
